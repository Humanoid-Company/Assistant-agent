# OpenAI API key — обов'язково.
OPENAI_API_KEY=sk-...

# Voice engine: realtime (legacy, default) | live (GPT-Live + Responses delegation)
VOICE_ENGINE=realtime

# GPT-Live settings (used when VOICE_ENGINE=live)
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_AUDIO_RATE=24000

# Шлях до Desktop OAuth client JSON (один проєкт розробника застосунку).
# Користувачі НЕ вводять власні API-ключі — лише проходять браузерний consent.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=credentials/client_secret.json

# Локальний стан активного Google-акаунта (без refresh tokens — токени в OS keyring).
GOOGLE_ACCOUNT_STATE_FILE=data/google_accounts.json

# Часовий пояс календаря (IANA).
GOOGLE_CALENDAR_TIMEZONE=Europe/Kyiv

# Інтервал фонової перевірки Google API (секунди). Відсутність входу не є аварією.
CONNECTIVITY_CHECK_INTERVAL_S=900

# Ім'я сервісу в OS keyring для refresh tokens.
GOOGLE_KEYRING_SERVICE=voice-agent-google-oauth

# Режим спільного пристрою / робота: true = idle lock + без авто-resume після restart.
# false (за замовчуванням) = особистий desktop — сесія Google зберігається.
SHARED_DEVICE_MODE=false

# Таймаут бездіяльності сесії в секундах (лише якщо SHARED_DEVICE_MODE=true).
SESSION_IDLE_TIMEOUT_S=300

# Бекенд фізичного робота: stub | go2 | humanoid
ROBOT_BACKEND=stub
ROBOT_NETWORK_INTERFACE=
