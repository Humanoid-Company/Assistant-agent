# OpenAI API key — обов'язково.
OPENAI_API_KEY=sk-...

# Voice engine: live (GPT-Live + Responses delegation, default) | realtime (legacy fallback)
VOICE_ENGINE=live

# Realtime: pause (ms) that ends a user turn. Lower = faster replies, too low cuts you off.
# REALTIME_SILENCE_MS=600

# GPT-Live settings (used when VOICE_ENGINE=live)
OPENAI_LIVE_MODEL=gpt-live-1
OPENAI_LIVE_BACKEND_MODEL=gpt-6-luna
OPENAI_LIVE_VOICE=marin
OPENAI_LIVE_AUDIO_RATE=24000

# Live UX: two-stage local barge-in (duck → confirm) + busy cues
# VOICE_LOCAL_BARGE_IN=true
# VOICE_BARGE_IN_ONSET_FRAMES=3
# VOICE_BARGE_IN_CONFIRM_MS=1200
# VOICE_BARGE_IN_MIN_SPEECH_MS=600
# VOICE_BARGE_IN_REJECT_SILENCE_MS=300
# VOICE_BARGE_IN_DUCK_VOLUME=0.5
# VOICE_BARGE_IN_USE_ENERGY_GATE=true
# VOICE_BARGE_IN_ENERGY_MARGIN=2.2
# VOICE_BARGE_IN_ENERGY_MARGIN_PLAYING=3.0
# VOICE_BARGE_IN_COOLDOWN_MS=500
# VOICE_BARGE_IN_SUPPRESS_MS=400
# VOICE_BUSY_CUES_ENABLED=true
# VOICE_BUSY_CUE_DELAY_MS=900
# VOICE_BUSY_CUE_SECOND_DELAY_MS=3000
# VOICE_BUSY_CUE_MAX_PER_TURN=2

# Шлях до Desktop OAuth client JSON (один проєкт розробника застосунку).
# Користувачі НЕ вводять власні API-ключі — лише проходять браузерний consent.
GOOGLE_OAUTH_CLIENT_SECRETS_FILE=credentials/client_secret.json

# Локальний стан активного Google-акаунта (без refresh tokens — токени в OS keyring).
GOOGLE_ACCOUNT_STATE_FILE=data/google_accounts.json

# Часовий пояс календаря (IANA).
GOOGLE_CALENDAR_TIMEZONE=Europe/Kyiv

# Таймаут одного HTTP-запиту до Google API (с). Голосовий хід не може чекати 60 с.
# GOOGLE_HTTP_TIMEOUT_S=15

# Інтервал фонової перевірки Google API (секунди). Відсутність входу не є аварією.
CONNECTIVITY_CHECK_INTERVAL_S=900

# Ім'я сервісу в OS keyring для refresh tokens.
GOOGLE_KEYRING_SERVICE=voice-agent-google-oauth

# Режим спільного пристрою / робота: true = idle lock + без авто-resume після restart.
# false (за замовчуванням) = особистий desktop — сесія Google зберігається.
SHARED_DEVICE_MODE=false

# Таймаут бездіяльності сесії в секундах (лише якщо SHARED_DEVICE_MODE=true).
SESSION_IDLE_TIMEOUT_S=300

# Публічний вебпошук для Live/Realtime tool `web_search` (Tavily).
# Без ключа tool повертає web_search_unavailable — сесія не падає.
WEB_SEARCH_API_KEY=
# WEB_SEARCH_TIMEOUT_S=9
# WEB_SEARCH_MAX_RESULTS_DEFAULT=5
# WEB_SEARCH_MAX_RESULTS_HARD=10
# WEB_SEARCH_MAX_CALLS_PER_TURN=3

# Бекенд фізичного робота: stub | go2 | humanoid
ROBOT_BACKEND=stub
ROBOT_NETWORK_INTERFACE=
